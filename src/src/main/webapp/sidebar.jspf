<%@page import="model.Account"%>
<%
    Account sidebarUser = (Account) session.getAttribute("userAccount");
    String activeMenu = (String) request.getAttribute("activeMenu");
    if (activeMenu == null) activeMenu = "";
%>
<aside class="sidebar">
    <div class="sidebar-header">
        <div class="logo-box">SL</div>
        <div class="brand-text">
            <h1>SmartLibrary</h1>
            <p>Library Management v5.0</p>
        </div>
    </div>

    <% if (sidebarUser != null && sidebarUser.getRole().equals("STUDENT")) { %>
    <div class="nav-section">
        <div class="nav-label">Main Menu</div>
        <a href="student_dashboard.jsp" class="nav-item <%= "dashboard".equals(activeMenu) ? "active" : "" %>">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
            Dashboard
        </a>
        <a href="CatalogServlet" class="nav-item <%= "catalog".equals(activeMenu) ? "active" : "" %>">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
            Katalog Koleksi
        </a>
    </div>
    <div class="nav-section">
        <div class="nav-label">Mahasiswa</div>
        <a href="ActiveLoansServlet" class="nav-item <%= "loans".equals(activeMenu) ? "active" : "" %>">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Aktivitas & Peminjaman
        </a>
    </div>
    <% } else if (sidebarUser != null && sidebarUser.getRole().equals("LIBRARIAN")) { %>
    <div class="nav-section">
        <div class="nav-label">Admin Menu</div>
        <a href="librarian_dashboard.jsp" class="nav-item <%= "dashboard".equals(activeMenu) ? "active" : "" %>">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
            Dashboard Admin
        </a>
        <a href="CatalogServlet" class="nav-item <%= "catalog".equals(activeMenu) ? "active" : "" %>">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
            Inventory & Katalog
        </a>
        <a href="add_resource.jsp" class="nav-item <%= "add_resource".equals(activeMenu) ? "active" : "" %>">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Tambah Koleksi
        </a>
        <a href="AdminApprovalServlet" class="nav-item <%= "approval".equals(activeMenu) ? "active" : "" %>">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Persetujuan Peminjaman
        </a>
    </div>
    <% } %>

    <div class="sidebar-footer">
        <div class="user-profile">
            <% if (sidebarUser != null) { %>
            <div class="user-avatar">
                <%= sidebarUser.getUsername().substring(0, 1).toUpperCase() %>
            </div>
            <div class="user-info">
                <h4><%= sidebarUser.getUsername() %></h4>
                <p><%= sidebarUser.getRole() %></p>
            </div>
            <a href="LogoutServlet" class="logout-btn" title="Logout">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
            </a>
            <% } %>
        </div>
    </div>
</aside>
